# ============================================================
# PRAXIS Agent — 环境变量配置模板
# ============================================================
# 使用方法：
#   1. 复制本文件为 .env：  cp .env.example .env
#   2. 按需修改 .env 中的值（不要提交 .env）
#   3. 启动前加载：  export $(cat .env | xargs)
#      （Windows PowerShell:  Get-Content .env | ForEach-Object { $k, $v = $_ -split '=', 2; [Environment]::SetEnvironmentVariable($k, $v) })
#
# 注意：
#   - 所有变量都有默认值，理论上不设置也能跑
#   - 标 [SECURITY] 的项必须显式设置强随机值
#   - 标 [OPTIONAL] 的项仅在启用对应功能时需要
# ============================================================


# ----------------------------------------------------------------
# 核心配置
# ----------------------------------------------------------------

# PRAXIS 工作区根目录（包含 data/、config/、logs/ 等子目录）
# 默认值："."（当前目录）
# 留空时回退到当前目录；显式设置指向数据所在的工作区
PRAXIS_WORKSPACE=


# ----------------------------------------------------------------
# 安全相关
# ----------------------------------------------------------------

# [SECURITY] 紧急解锁 Guardrail 的令牌
# 默认值：""（空 → 紧急解锁功能被禁用）
# 用途：当 Guardrail 锁定且无法通过正常流程解锁时，用于一次性紧急覆盖
# 要求：必须使用强随机值（建议 openssl rand -hex 32 或 uuidgen | tr -d '-'）
# 警告：这是最敏感的配置，泄露等同于绕过所有写入风控
# 占位示例（**请替换**）：
# PRAXIS_EMERGENCY_TOKEN=replace-with-openssl-rand-hex-32


# ----------------------------------------------------------------
# 功能开关（Feature Flags）
# ----------------------------------------------------------------

# 是否启用 Agent 多智能体调度
# 默认值：true
PRAXIS_AGENT_MODE=true

# 是否启用 Guardrail 三态状态机（写操作风控）
# 默认值：true
PRAXIS_GUARDRAIL_ENABLED=true

# 存储后端选择
# 默认值：jsonl
# 可选：jsonl | sqlite
PRAXIS_STORAGE_BACKEND=jsonl

# 是否启用记忆库（SimpleMemoryStore + EmbeddingEngine）
# 默认值：false
# 启用后需要更多内存与磁盘
PRAXIS_MEMORY_ENABLED=false

# 编排模式
# 默认值：agent
# 可选：agent | direct
PRAXIS_ORCHESTRATION_MODE=agent


# ----------------------------------------------------------------
# MCP Server 配置
# ----------------------------------------------------------------

# MCP 传输协议
# 默认值：stdio
# 可选：stdio | sse
PRAXIS_TRANSPORT=stdio

# MCP 服务监听地址（仅 sse 模式生效）
# 默认值：127.0.0.1
PRAXIS_HOST=127.0.0.1

# MCP 服务监听端口（仅 sse 模式生效）
# 默认值：8080
PRAXIS_PORT=8080

# 工具调用超时秒数
# 默认值：30
PRAXIS_TOOL_TIMEOUT=30

# httpx 代理跳过列表（设默认值 "*" 让所有数据源直连，避免代理拦截）
# 默认值：*（praxis-agent 启动时自动 setdefault）
NO_PROXY=*


# ----------------------------------------------------------------
# 日志
# ----------------------------------------------------------------

# 日志级别
# 默认值：INFO
# 可选：DEBUG | INFO | WARNING | ERROR | CRITICAL
PRAXIS_LOG_LEVEL=INFO

# 是否输出 JSON 格式日志（生产推荐 true，本地调试可改 false 看可读输出）
# 默认值：true
PRAXIS_LOG_JSON=true


# ----------------------------------------------------------------
# 内部使用（一般无需手动设置）
# ----------------------------------------------------------------

# Python 模块搜索路径（QA 脚本启动时自动设置）
# 一般无需手动配置
# PYTHONPATH=./src
